# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Raw data, detector scores and intermediate caches (large / regenerable).
# Keep data/synthetic_rho/*.txt (sources); ignore EasyTSAD-converted UTS/.
Results/
data/UTS/
*.npy
*.npz
*.pkl
*.pickle
*.zip

# Generated figures (keep the folder, drop the artifacts)
figures/*
!figures/.gitkeep
!figures/seriejavi_scores/

# Virtual environments
.venv/
venv/
env/

# Vendored third-party libraries (lib/EasyTSAD, lib/tsadalia): committed as
# source, but exclude their virtualenvs, caches and nested git metadata.
# Licensing: lib/EasyTSAD is GPL-3.0, lib/tsadalia is MIT (see README.md).
lib/**/venv/
lib/**/.venv/
lib/**/__pycache__/
lib/**/*.egg-info/
lib/**/.git/
lib/**/.vscode/
lib/EasyTSAD/Mkdocs/site/
# Optional reference clone of zamanzadeh/CARLA (we ship an EasyTSAD adapter).
lib/CARLA/

# IDE / OS
.idea/
.vscode/
.DS_Store
